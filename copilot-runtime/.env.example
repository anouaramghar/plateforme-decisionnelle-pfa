# copilot-runtime — copy to .env and fill in real values. Never commit .env.
# The runtime now uses NVIDIA NIM (OpenAI-compatible endpoint), NOT Anthropic.

# Get a real key at https://build.nvidia.com (sign up → "Get API Key").
# Same key works for every model on the NIM endpoint.
NVIDIA_NIM_API_KEY=nvapi-CHANGE_ME_GET_KEY_FROM_BUILD_NVIDIA_COM
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
COPILOT_MODEL_ROUTER=meta/llama-3.3-70b-instruct

PORT=4000

# Required for verifying authorization tokens (JWT). MUST match the backend's
# JWT_SECRET (>= 32 chars). Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_TO_A_SECRET_AT_LEAST_32_CHARS_LONG

# Shared secret for copilot-runtime -> backend tool callbacks (X-Internal-Token).
# MUST match the backend's AGENT_INTERNAL_TOKEN. Generate with: openssl rand -hex 32
AGENT_INTERNAL_TOKEN=CHANGE_ME_SHARED_AGENT_SECRET

# Standalone-dev only — in Docker, docker-compose hardcodes the internal URL.
BACKEND_URL=http://localhost:5135
FRONTEND_URL=http://localhost:5173
