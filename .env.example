# ─── SQL Server ───────────────────────────────────────────────
# ⚠️  Replace with strong, DISTINCT passwords. Never commit the real .env file.
# SA_PASSWORD and APP_DB_PASSWORD MUST differ — sharing the password collapses
# the least-privilege boundary that the pfa_app login was designed to enforce.
# Generate with: openssl rand -base64 24
SA_PASSWORD=CHANGE_ME_run_openssl_rand_base64_24
DB_NAME=PFA_DB
# Password for the least-privilege application login (pfa_app).
# Created by init.sql; used by the backend connection string.
APP_DB_PASSWORD=CHANGE_ME_run_openssl_rand_base64_24_different
# Password for the Copilot read-only DW login (pfa_app_readonly), used by the
# agent-service query_dw tool. MUST differ from APP_DB_PASSWORD so a leak of the
# read-write app credential does not also hand over read access (and vice versa).
# Created by database/copilot_readonly.sql. Generate with: openssl rand -base64 24
READONLY_DB_PASSWORD=CHANGE_ME_run_openssl_rand_base64_24_readonly

# ─── Backend ASP.NET Core ─────────────────────────────────────
# Use "Production" for any deployed environment. "Development" exposes Swagger & detailed errors.
ASPNETCORE_ENVIRONMENT=Production
# ⚠️  Must be ≥32 chars with at least 3 character classes (lower/upper/digit/symbol).
# Backend refuses to start if this is missing, weak, or matches a known-leaked value.
# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_run_openssl_rand_base64_48
JWT_ISSUER=pfa-api
JWT_AUDIENCE=pfa-frontend

# Comma-separated list of origins allowed to call /api/* directly (Vite dev server,
# any direct cross-origin call). In Docker, nginx proxies same-origin so this is
# only needed for local dev. Leave the default unless you know what you're doing.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost,http://localhost:80

# ─── Admin Seed (first-boot only) ─────────────────────────────
# DataSeeder creates the first Admin user from these values. After first boot,
# change the password via the API. Seeder refuses to run if password is < 12
# chars or still equals a placeholder.
ADMIN_SEED_EMAIL=admin@eniad.ma
ADMIN_SEED_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
ADMIN_SEED_NOM=Admin
ADMIN_SEED_PRENOM=ENIAD

# ─── ML Service (FastAPI) ─────────────────────────────────────
ML_API_URL=http://ml-service:8000
# Shared secret for backend ↔ ml-service calls (sent as X-Internal-Token header).
# Generate with: openssl rand -hex 32
ML_INTERNAL_TOKEN=CHANGE_ME_SHARED_INTERNAL_SECRET

# Shared secret for backend ↔ agent-service calls. Distinct from ML_INTERNAL_TOKEN
# so a leak of one does not compromise the other. Generate with: openssl rand -hex 32
AGENT_INTERNAL_TOKEN=CHANGE_ME_SHARED_AGENT_SECRET

# ─── Frontend React (Vite) ────────────────────────────────────
# Relative path — nginx reverse-proxies /api/ to the backend service.
VITE_API_URL=/api

# CopilotKit standalone demo runtime (run `npm run dev` inside copilot-runtime/).
# Defaults to http://localhost:4000/api/copilotkit if not set.
VITE_COPILOTKIT_URL=http://localhost:4000/api/copilotkit

# ─── CopilotKit Runtime (copilot-runtime/) ────────────────────
# Anthropic API key — required for BuiltInAgent (claude-sonnet-4-5).
# Get one at https://console.anthropic.com/keys
ANTHROPIC_API_KEY=sk-ant-PUT-YOUR-KEY-HERE

# Where copilot-runtime can reach the backend (local dev).
# In Docker, set this to http://backend:8080
BACKEND_URL=http://localhost:5135

# Frontend origin allowed by copilot-runtime CORS (local dev).
FRONTEND_URL=http://localhost:5173

# ─── NVIDIA NIM (Copilot agent-service) ───────────────────────
# Free endpoint at https://build.nvidia.com — sign up, click "Get API Key".
# Same key works for every model on NIM. Do NOT commit a real value.
NVIDIA_NIM_API_KEY=nvapi-PUT-YOUR-KEY-HERE

# Copilot model picks (smoke-tested 2026-05-26, see scripts/nim_smoke_test.py).
COPILOT_MODEL_ROUTER=meta/llama-3.3-70b-instruct
COPILOT_MODEL_SQL=minimaxai/minimax-m2.7
COPILOT_MODEL_REASON=nvidia/llama-3.3-nemotron-super-49b-v1.5
COPILOT_MODEL_SAFETY=nvidia/llama-3.1-nemotron-safety-guard-8b-v3
COPILOT_EMBED_MODEL=nvidia/nv-embedqa-e5-v5

# Copilot limits (defense in depth — L6 of the safety layer).
COPILOT_DAILY_TOKEN_CAP_PER_USER=200000
COPILOT_MAX_TOOL_ITERATIONS=8
COPILOT_TURN_TOKEN_BUDGET_IN=20000
COPILOT_TURN_TOKEN_BUDGET_OUT=4000

# Read-only DW connection for the future query_dw tool (P1.B). Uses the
# dedicated read-only credential. NOTE: paste the literal READONLY_DB_PASSWORD
# value here — Compose does not recursively expand ${...} inside another
# variable's value, so write the password out rather than referencing it.
COPILOT_DW_READONLY_CONN=Server=db,1433;Database=PFA_DW;User Id=pfa_app_readonly;Password=CHANGE_ME_run_openssl_rand_base64_24_readonly;TrustServerCertificate=True;

# Where backend reaches the agent-service. Internal-only DNS in pfa_internal_ml.
AGENT_SERVICE_URL=http://agent-service:8001

# How the agent-service reaches the backend to run tools (internal network).
BACKEND_INTERNAL_URL=http://backend:8080
