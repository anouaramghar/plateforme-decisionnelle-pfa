# ─── SQL Server ───────────────────────────────────────────────
# ⚠️  Replace with strong, DISTINCT passwords (≥32 chars each). Never commit
#     the real .env file. SA_PASSWORD and APP_DB_PASSWORD MUST differ — sharing
#     the password collapses the least-privilege boundary that the pfa_app
#     login was designed to enforce.
# Generate with: openssl rand -base64 24   (yields ≥32 chars)
SA_PASSWORD=CHANGE_ME_run_openssl_rand_base64_24
DB_NAME=PFA_DB
# Password for the least-privilege application login (pfa_app).
# ≥32 chars. Created by init.sql; used by the backend connection string.
APP_DB_PASSWORD=CHANGE_ME_run_openssl_rand_base64_24_different
# Password for the Copilot read-only DW login (pfa_app_readonly), used by the
# backend query_dw tool AND by the ML service's DW training-data reads.
# ≥32 chars. MUST differ from APP_DB_PASSWORD so a leak of one does not expose
# the other. Created by database/copilot_readonly.sql.
# Generate with: openssl rand -base64 24
READONLY_DB_PASSWORD=CHANGE_ME_run_openssl_rand_base64_24_readonly

# ─── Backend ASP.NET Core ─────────────────────────────────────
# Use "Production" for any deployed environment. "Development" exposes Swagger
# & detailed errors. This is the documented DEFAULT — leave it as Production
# unless you are debugging locally with `dotnet run`.
ASPNETCORE_ENVIRONMENT=Production
# ⚠️  Must be ≥32 chars with at least 3 character classes (lower/upper/digit/symbol).
# Backend refuses to start if this is missing, weak, or matches a known-leaked value.
# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_run_openssl_rand_base64_48
JWT_ISSUER=pfa-api
JWT_AUDIENCE=pfa-frontend

# Comma-separated list of origins allowed to call /api/* directly (Vite dev server,
# any direct cross-origin call). In Docker, nginx proxies same-origin so this is
# only needed for local dev. Leave the default unless you know what you're doing.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost,http://localhost:80

# ─── Admin Seed (first-boot only) ─────────────────────────────
# DataSeeder creates the first Admin user from these values. After first boot,
# change the password via the API. Seeder refuses to run if the password is
# < 12 chars or still equals a placeholder (≥32 chars recommended for strength).
ADMIN_SEED_EMAIL=admin@eniad.ma
ADMIN_SEED_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
ADMIN_SEED_NOM=Admin
ADMIN_SEED_PRENOM=ENIAD

# ─── Email (SMTP — case communications) ───────────────────────
# Outbound student emails from intervention cases. Defaults target Gmail:
# set SMTP_USER to the Gmail address and SMTP_PASS to an APP PASSWORD
# (not the account password — requires 2FA enabled on the account).
# Privacy: real student data leaves the cluster to Google — see CLAUDE.md.
# Leave SMTP_USER/PASS empty to disable sending (emails record as Failed,
# stay retryable). 587 = STARTTLS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ─── ML Service (FastAPI) ─────────────────────────────────────
ML_API_URL=http://ml-service:8000
# Shared secret for backend ↔ ml-service calls (sent as X-Internal-Token header).
# ≥32 chars. Generate with: openssl rand -hex 32
ML_INTERNAL_TOKEN=CHANGE_ME_SHARED_INTERNAL_SECRET

# Shared secret for copilot-runtime ↔ backend tool calls (X-Internal-Token).
# ≥32 chars. Distinct from ML_INTERNAL_TOKEN so a leak of one does not compromise
# the other. Generate with: openssl rand -hex 32
AGENT_INTERNAL_TOKEN=CHANGE_ME_SHARED_AGENT_SECRET

# ─── Frontend React (Vite) ────────────────────────────────────
# Relative path — nginx reverse-proxies /api/ to the backend service.
VITE_API_URL=/api

# ─── TLS (nginx) ──────────────────────────────────────────────
# Set to true to serve HTTPS on 443 and redirect 80 → 443. Requires a cert
# at nginx/certs/fullchain.pem + nginx/certs/privkey.pem. Generate a
# self-signed dev cert with:  ./nginx/generate-dev-certs.sh [hostname]
# For production use Let's Encrypt (certbot) or your institutional CA.
# Leave false for the plain HTTP dev setup.
ENABLE_TLS=false

# ─── DB backups (db-backup sidecar) ───────────────────────────
# Interval between backups, in seconds (86400 = daily). The sidecar also
# runs one backup immediately on boot for a baseline.
BACKUP_INTERVAL_SECONDS=86400
# Delete .bak files older than this many days. Set to 0 to keep forever.
BACKUP_RETENTION_DAYS=7
# .bak files live in the db_backups named volume. For real DR, copy that
# volume's contents OFF-HOST (S3 / NAS / another machine) — a backup on the
# same host as the DB is not disaster recovery.

# ─── MLflow (model lineage) ───────────────────────────────────
# Tracking URI for the ML service. The default points at the mlflow
# container. Set to empty to disable MLflow logging entirely (training
# proceeds with joblib-on-disk only).
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=pfa_student_risk
# The MLflow UI is published at 127.0.0.1:5001 on the host (not via nginx,
# so it is never internet-facing). Visit http://localhost:5001 when the
# stack is up.

# CopilotKit runtime URL, read by Vite AT BUILD TIME and baked into the bundle.
# LEAVE THIS UNSET for Docker / production: the app then falls back to the
# relative path /api/copilotkit, which nginx proxies to the copilot-runtime
# container. Only set it (e.g. http://localhost:4000/api/copilotkit) when
# running the Vite dev server against a standalone runtime via `npm run dev`.
# VITE_COPILOTKIT_URL=http://localhost:4000/api/copilotkit

# ─── CopilotKit Runtime (copilot-runtime/) ────────────────────
# Authenticates the runtime's JWT verification. MUST match JWT_SECRET above.
# The runtime now uses NVIDIA NIM (see NVIDIA_NIM_API_KEY below), not Anthropic.

# Where copilot-runtime reaches the backend. The docker-compose service
# hardcodes http://backend:8080; this value is only for running the runtime
# standalone on the host (`npm run dev` inside copilot-runtime/).
BACKEND_URL=http://localhost:5135

# Frontend origin allowed by copilot-runtime CORS (standalone dev only —
# moot in Docker since the browser calls /api/copilotkit same-origin via nginx).
FRONTEND_URL=http://localhost:5173

# ─── NVIDIA NIM (CopilotKit runtime) ─────────────────────────
# Free endpoint at https://build.nvidia.com — sign up, click "Get API Key".
# Same key works for every model on NIM. Do NOT commit a real value.
NVIDIA_NIM_API_KEY=nvapi-CHANGE_ME_GET_KEY_FROM_BUILD_NVIDIA_COM

# Model used by the CopilotKit runtime BuiltInAgent. Must be a tool-calling
# model — reasoning models (deepseek-v4-*, nemotron) break the agent loop.
# NIM's shared 70b endpoints can queue 60-90s under load ("ResourceExhausted:
# Worker local total request limit reached"); if the Copilot feels hung, use
# meta/llama-3.1-8b-instruct (sub-second, tool-calling verified 2026-07-03).
COPILOT_MODEL_ROUTER=meta/llama-3.1-8b-instruct

# Read-only DW connection string for CopilotToolController (query_dw tool) and
# the ML service's training-data reads. docker-compose passes READONLY_DB_PASSWORD
# via backend + ml-service env; for standalone dev paste the password literally —
# ASP.NET reads this as the COPILOT_DW_READONLY_CONN config key.
COPILOT_DW_READONLY_CONN=Server=localhost,1433;Database=PFA_DW;User Id=pfa_app_readonly;Password=CHANGE_ME_run_openssl_rand_base64_24_readonly;TrustServerCertificate=True;
