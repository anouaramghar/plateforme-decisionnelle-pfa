# Environment (never commit real secrets)
.env
.env.*
!.env.example

# Node
node_modules/
dist/
.vite/
coverage/

# .NET
bin/
obj/
*.user
.vs/
# Environment-specific appsettings carry real secrets — never commit them.
# Only the base appsettings.json (defaults) is safe to track.
**/appsettings.Development.json
**/appsettings.Local.json

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
.mypy_cache/

# ML Models (trop lourds pour Git) + eval artefacts
ml_service/saved_models/*.pkl
ml_service/saved_models/*.joblib
ml_service/saved_models/*.parquet
ml_service/saved_models/*metadata.json

# OS
.DS_Store
Thumbs.db

# Git worktrees (Claude Code)
.claude/worktrees/
.worktrees/
frontend/tsconfig.app.tsbuildinfo
frontend/tsconfig.node.tsbuildinfo

# Agent / dev tooling scratch dirs
.claude/
.codex-dev-logs/
.devlogs/

# Runtime logs
*.err
*.log

# Raw ML datasets (large, not for Git)
ml_service/data/raw/

# Stray root lockfile (no root package.json; frontend has its own)
/package-lock.json
